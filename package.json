{
  "name": "mwi-profit-indices",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "check": "npm test && npm run build && npm run release:check && npm run test:browser",
    "format": "prettier --write \"src/**/*.{js,css}\" \"scripts/*.mjs\" \"tests/*.{js,mjs}\"",
    "release:check": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.56.1",
    "prettier": "3.6.2",
    "react": "16.14.0",
    "react-dom": "16.14.0"
  }
}
